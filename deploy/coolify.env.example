# Variables to paste into Coolify (Environment Variables > Developer view).
# Coolify generates SERVICE_FQDN_APP, SERVICE_URL_APP, SERVICE_USER_POSTGRES,
# SERVICE_PASSWORD_POSTGRES, SERVICE_PASSWORD_REDIS and SERVICE_BASE64_64_SESSION:
# do not set them here. Guide: deploy/COOLIFY.md

# --- Required --------------------------------------------------------------
# Host folder with the shares, mounted at /data/shares.
SHARES_HOST_PATH=/srv/fileshares
# Host folder with shares.yaml, mounted read-only at /config (hot reloaded).
SHARES_CONFIG_HOST_DIR=/srv/wfb/config
SHARES_CONFIG_FILE=shares.yaml
# Owner of SHARES_HOST_PATH: `stat -c '%u:%g' /srv/fileshares`
PUID=1000
PGID=1000

# --- General ---------------------------------------------------------------
TZ=Europe/Madrid
LOG_LEVEL=info
SESSION_TTL_HOURS=12
MAX_UPLOAD_MB=1024
# Office previews (Word/Excel/PowerPoint -> PDF). Bigger image (~+650 MB), slower build.
INSTALL_LIBREOFFICE=false

# --- Active Directory (docs/identity.md) -----------------------------------
DIRECTORY_KIND=ad
DIRECTORY_LABEL=Cuenta corporativa
LDAP_URL=ldaps://dc01.corp.example.com:636
LDAP_BIND_DN=CN=svc-wfb,OU=Service Accounts,DC=corp,DC=example,DC=com
LDAP_BIND_PASSWORD=change-me
LDAP_BASE_DN=DC=corp,DC=example,DC=com
LDAP_USER_FILTER=(&(objectClass=user)(|(sAMAccountName={{username}})(userPrincipalName={{username}}))(!(userAccountControl:1.2.840.113556.1.4.803:=2)))
AD_DOMAIN=corp.example.com
# NODE_EXTRA_CA_CERTS=/config/corp-root-ca.pem

# --- OpenLDAP (instead of AD) ----------------------------------------------
# DIRECTORY_KIND=ldap
# LDAP_URL=ldap://ldap.example.com:389
# LDAP_START_TLS=true
# LDAP_BIND_DN=cn=readonly,dc=example,dc=com
# LDAP_BIND_PASSWORD=change-me
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_USER_FILTER=(uid={{username}})

# --- Authentik OIDC (docs/identity.md) -------------------------------------
OIDC_ISSUER=https://auth.example.com/application/o/wfb/
OIDC_CLIENT_ID=wfb
OIDC_CLIENT_SECRET=change-me
OIDC_LABEL=Authentik
OIDC_SCOPES=openid profile email groups
OIDC_GROUPS_CLAIM=groups
OIDC_TOKEN_AUTH_METHOD=client_secret_post
