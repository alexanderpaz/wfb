{
  "name": "@wfb/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/static": "^8.0.2",
    "@prisma/client": "^5.22.0",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.1",
    "ldapts": "^9.2.0",
    "openid-client": "^6.8.8",
    "pino": "^9.5.0",
    "prisma": "^5.22.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@wfb/contracts": "workspace:*",
    "jose": "^6.2.13",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "vitest": "^2.1.4"
  }
}
