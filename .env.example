# Local development (pnpm dev). Copy to .env
# Production variables for Coolify: deploy/coolify.env.example and deploy/COOLIFY.md
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
LOG_LEVEL=info
# Proxy addresses/CIDRs whose X-Forwarded-For is trusted (false when nothing proxies the app).
TRUST_PROXY=false
# Human readable logs; needs `pnpm add -D pino-pretty --filter @wfb/api`. Ignored in production.
LOG_PRETTY=false
SESSION_SECRET=dev-secret-change-me

DATABASE_URL=postgresql://wfb:wfb@localhost:5432/wfb?schema=public
REDIS_URL=redis://localhost:6379/0

DIRECTORY_KIND=ldap
LDAP_URL=ldap://localhost:1389
LDAP_BIND_DN=cn=readonly,dc=example,dc=org
LDAP_BIND_PASSWORD=readonly
LDAP_BASE_DN=dc=example,dc=org

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TOKEN_AUTH_METHOD=client_secret_post

SHARES_CONFIG=./config/shares.dev.yaml
DATA_DIR=./.data
